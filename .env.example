# Database & Supabase PostgreSQL Configuration
# Connect your Supabase PostgreSQL instance using the direct or pooled connection string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials (Optional - for Supabase Auth, Storage, and Realtime features)
SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Administrator Bootstrap Configuration
ADMIN_EMAIL="admin@xorvilahost.com"
ADMIN_INITIAL_PASSWORD=""

# Session & Security
SESSION_SECRET="craft_command_jwt_secret_change_in_production"

# OAuth 2.0 Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000
